# Neon PostgreSQL connection string
DATABASE_URL=postgresql://username:password@host/nevo?sslmode=require

# App-level secrets
# Signs admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace_with_at_least_32_random_characters

# Cloudinary photo uploads (dashboard → API Keys). The cloud name is public;
# the API secret must stay server-side and is only used to sign uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional public config
NEXT_PUBLIC_APP_URL=http://localhost:3000
